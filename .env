# ============================================================
# .env  —  Local secrets and environment overrides
# ============================================================
# ⚠  This file is listed in .gitignore and must NEVER be committed.
# ⚠  Copy .env.example to create this file on a new machine.
# ============================================================

# ----- MySQL -----
DB_HOST='localhost'
DB_USER='root'
DB_PASSWORD='root'
DB_NAME='facial_attendance'

# ----- Camera -----
CAMERA_INDEX='0'

# ----- Face Recognition -----
SIMILARITY_THRESHOLD='0.5'

# ----- Attendance Rules -----
# Late arrival threshold (HH:MM, 24-hour)
LATE_THRESHOLD='10:05'

# Cooldown in seconds before the same face can mark attendance again
ATTENDANCE_COOLDOWN='20'

# ----- Logging -----
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
